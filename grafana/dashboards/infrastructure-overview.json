    {
      "id": 3,
      "type": "stat",
      "title": "Firing Alerts",
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ALERTS{alertstate=\"firing\"}) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 1, "color": "red"}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU Usage",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{job=\"linux\",mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "Linux {{instance}}"
        },
        {
          "refId": "B",
          "expr": "100 - (avg by(instance) (rate(windows_cpu_time_total{job=\"windows\",mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "Windows {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Memory Usage",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes{job=\"linux\"} / node_memory_MemTotal_bytes{job=\"linux\"}))",
          "legendFormat": "Linux {{instance}}"
        },
        {
          "refId": "B",
          "expr": "100 * (1 - (windows_memory_physical_free_bytes{job=\"windows\"} / windows_memory_physical_total_bytes{job=\"windows\"}))",
          "legendFormat": "Windows {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Disk Free %",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (node_filesystem_avail_bytes{job=\"linux\",fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{job=\"linux\",fstype!~\"tmpfs|overlay|squashfs\"})",
          "legendFormat": "Linux {{mountpoint}}"
        },
        {
          "refId": "B",
          "expr": "100 * (windows_logical_disk_free_bytes{job=\"windows\"} / windows_logical_disk_size_bytes{job=\"windows\"})",
          "legendFormat": "Windows {{volume}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    }
  ],
